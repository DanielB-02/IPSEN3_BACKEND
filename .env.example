# Copy this file to .env and replace the values. .env is gitignored.
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=change-me-to-a-base64-encoded-256-bit-key
# Optional
# SERVER_PORT=8081
# DDL_AUTO=create-drop
# DEBUG=false
